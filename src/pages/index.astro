---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import ContactReveal from '../components/ContactReveal.astro';
import { Globe, ShoppingBag, Search, Megaphone, Workflow, Bot } from '@lucide/astro';

const site = 'https://ongki.pro';
const title = 'ongki.pro — Building Digital Growth Systems';
const description =
  'A digital growth systems builder. Websites, commerce, SEO, paid media, and AI automation — engineered as one operating layer that compounds.';
const ogImage = `${site}/og.png`;

const headline = [{ text: 'Digital' }, { text: 'Growth', accent: true }, { text: 'Systems.' }];

// Blueprint nodes (hero signature)
const nodes = [
  { id: 'site', label: 'SITE', x: 70, y: 70 },
  { id: 'shop', label: 'SHOP', x: 70, y: 290 },
  { id: 'seo', label: 'SEO', x: 250, y: 40 },
  { id: 'ads', label: 'ADS', x: 250, y: 320 },
  { id: 'hub', label: 'GROWTH', x: 250, y: 180, hub: true },
  { id: 'auto', label: 'AUTO', x: 450, y: 95 },
  { id: 'agent', label: 'AGENT', x: 450, y: 265 },
];
const links = [
  ['site', 'hub'], ['shop', 'hub'], ['seo', 'hub'], ['ads', 'hub'],
  ['hub', 'auto'], ['hub', 'agent'],
];
const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
const path = (a: string, b: string) => {
  const p = byId[a], q = byId[b];
  const mx = (p.x + q.x) / 2;
  return `M ${p.x} ${p.y} C ${mx} ${p.y}, ${mx} ${q.y}, ${q.x} ${q.y}`;
};

// 02 · capabilities
const capabilities = [
  { icon: Globe, label: 'Website Development', desc: 'High-performance sites engineered for speed, SEO, and conversion.' },
  { icon: ShoppingBag, label: 'Shopify Commerce', desc: 'Scalable storefronts and custom commerce architecture — headless when it counts.' },
  { icon: Search, label: 'SEO Infrastructure', desc: 'Technical foundations and content systems that compound organic growth.' },
  { icon: Megaphone, label: 'Meta & Google Ads', desc: 'Data-driven paid media with tracking built to scale profitably.' },
  { icon: Workflow, label: 'AI Automation', desc: 'Workflows that remove manual work from operations and marketing.' },
  { icon: Bot, label: 'AI Agents', desc: 'Autonomous systems that execute, assist, and run on their own.' },
];

// 03 · principles
const principles = [
  { n: 'A', t: 'Systems, not deliverables.', d: 'I build reusable systems and assets — not one-off projects that stall the moment they ship.' },
  { n: 'B', t: 'Automation-first.', d: 'Every workflow is designed to run without me — operated by a team, an intern, or an AI agent.' },
  { n: 'C', t: 'Compounding by design.', d: 'SEO, content, and infrastructure that gain value over time, instead of campaigns that reset to zero.' },
];

// 04 · selected work (real, in production)
const work = [
  { name: 'Pixs&Go', cat: 'Ecommerce', stack: 'Astro · Shopify', desc: 'Toys & hobbies storefront (Play & Go).', url: 'pixsgo.com' },
  { name: 'PetCue', cat: 'Ecommerce', stack: 'Astro · Shopify', desc: 'Pet-care storefront + automated blog engine.', url: 'petcue.co' },
  { name: 'Dealer Hino', cat: 'Corporate', stack: 'Astro · Cloudflare', desc: 'Official dealer site — 251 pages, edge-deployed.', url: 'dealerhinoofficial.com' },
  { name: 'RTQ Al-Hadi', cat: 'Institution', stack: 'Astro · Vercel', desc: 'Tahfidz institute — multi-page, live.', url: 'rtqalhadi.com' },
  { name: 'Heimwerk-Guide', cat: 'Affiliate SEO', stack: 'Astro SSR · Cloudflare', desc: 'German Amazon affiliate engine (D1/KV).', url: 'fitsst.com' },
  { name: 'Indostore', cat: 'SaaS', stack: 'Next.js · Astro · Postgres', desc: 'Shopify-style commerce platform for Indonesia.', url: '' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#04050a" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ongki" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={site} />

    <!-- Set the time-of-day phase (WIB) before paint — no colour flash. -->
    <script is:inline>
      (function () {
        try {
          var forced = new URLSearchParams(location.search).get('phase');
          var w = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Jakarta' }));
          var h = w.getHours() + w.getMinutes() / 60;
          var ph = ['dawn', 'day', 'dusk', 'night'].indexOf(forced) >= 0 ? forced
            : h >= 5 && h < 8 ? 'dawn' : h >= 8 && h < 16 ? 'day' : h >= 16 && h < 19 ? 'dusk' : 'night';
          document.documentElement.setAttribute('data-phase', ph);
        } catch (e) {
          document.documentElement.setAttribute('data-phase', 'night');
        }
      })();
    </script>
  </head>

  <body>
    <!-- Boot loader: celestial (sun/moon at its real WIB position) + tech -->
    <div id="loader">
      <div class="loader-inner">
        <svg class="celestial" viewBox="0 0 400 210" aria-hidden="true">
          <line class="cel-horizon" x1="24" y1="190" x2="376" y2="190" />
          <path class="cel-arc" d="M 40 190 A 160 160 0 0 1 360 190" />
          <line class="cel-tick" x1="40" y1="186" x2="40" y2="194" />
          <line class="cel-tick" x1="200" y1="26" x2="200" y2="34" />
          <line class="cel-tick" x1="360" y1="186" x2="360" y2="194" />
          <g id="cel-body-g">
            <g id="cel-rays"></g>
            <circle class="cel-body-ring" id="cel-ring" r="19" />
            <circle class="cel-body" id="cel-disc" r="12" />
            <circle id="cel-moon-mask" r="12" fill="var(--color-bg)" />
          </g>
        </svg>
        <div class="loader-meta">
          <div class="loader-percent"><span id="loader-percent">000</span></div>
          <div class="loader-bar"><span id="loader-bar"></span></div>
          <div class="loader-status" id="loader-status">Reading almanac</div>
          <div class="loader-phase" id="loader-phase"></div>
        </div>
      </div>
    </div>

    <div class="bg-grid" aria-hidden="true"></div>
    <div id="bg-glow" class="bg-glow" aria-hidden="true"></div>
    <div class="bg-vignette" aria-hidden="true"></div>
    <div class="bg-noise" aria-hidden="true"></div>

    <!-- scroll progress rail -->
    <div class="progress-rail" aria-hidden="true"><span id="progress-fill"></span></div>

    <header class="fixed inset-x-0 top-0 z-50">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 md:px-10">
        <a data-head href="/" class="font-mono text-sm tracking-[0.22em] text-white/90">
          ongki<span class="text-accent">.pro</span>
        </a>
        <div data-head class="eyebrow">
          <span id="sys-dot" class="relative flex size-1.5">
            <span class="ping bg-accent/60 absolute inline-flex h-full w-full animate-ping rounded-full"></span>
            <span class="bg-accent relative inline-flex size-1.5 rounded-full"></span>
          </span>
          <span id="sys-status">System Online</span>
        </div>
      </div>
    </header>

    <main>
      <!-- 01 · HERO -->
      <section id="hero" class="relative z-10 flex min-h-[100svh] items-center">
        <div class="mx-auto grid w-full max-w-7xl items-center gap-12 px-6 md:px-10 lg:grid-cols-[1.05fr_0.95fr]">
          <div class="text-center lg:text-left">
            <p data-hero="eyebrow" class="eyebrow justify-center lg:justify-start">
              <span class="tick"></span> <b>01</b> · Digital Growth OS
            </p>
            <h1 class="display mt-6 text-[clamp(2.5rem,9vw,5.5rem)] text-white">
              <span class="word"><span class="word-inner text-white/55">Building</span></span>
              {
                headline.map((w) => (
                  <span class="word">
                    <span
                      class:list={[
                        'word-inner',
                        w.accent && 'from-accent-bright via-accent to-accent-bright bg-gradient-to-br bg-clip-text text-transparent',
                      ]}
                    >
                      {w.text}
                    </span>
                  </span>
                ))
              }
            </h1>
            <p data-hero="sub" class="mx-auto mt-7 max-w-md text-[15px] leading-relaxed text-white/55 md:text-lg lg:mx-0">
              Websites, commerce, SEO, paid media, and AI automation — engineered as
              <span class="text-white/80">one operating layer</span> that compounds.
            </p>
            <p data-hero="sub" class="mt-8 flex items-center justify-center gap-2 font-mono text-[10.5px] tracking-[0.2em] text-white/40 uppercase lg:justify-start">
              <span class="tick"></span> Independent systems builder · Indonesia
            </p>
          </div>

          <div data-hero="blueprint" class="relative mx-auto w-full max-w-[520px]">
            <svg class="blueprint" viewBox="0 0 520 360" role="img" aria-label="Digital growth system diagram">
              <g stroke-linecap="round">
                {links.map(([a, b]) => <path class="bp-path" data-link d={path(a, b)} />)}
              </g>
              {
                nodes.map((n) => (
                  <g class="bp-node" data-node transform={`translate(${n.x} ${n.y})`}>
                    <circle r={n.hub ? 26 : 15} />
                    {n.hub && <circle class="bp-hub-ring" r="34" fill="none" stroke="var(--color-accent)" stroke-opacity="0.35" stroke-dasharray="2 5" />}
                    <text text-anchor="middle" dy={n.hub ? 3 : -24}>{n.label}</text>
                  </g>
                ))
              }
            </svg>
          </div>
        </div>
        <div data-hero="sub" class="absolute inset-x-0 bottom-7 flex justify-center">
          <div class="eyebrow flex-col gap-1.5"><span>Scroll</span><span class="scroll-cue"></span></div>
        </div>
      </section>

      <!-- 02 · THE SYSTEM -->
      <section class="story-section">
        <p data-reveal class="eyebrow"><span class="tick"></span> <b>02</b> · The Operating Layer</p>
        <h2 data-reveal class="display mt-6 max-w-3xl text-[clamp(1.9rem,5.5vw,3.4rem)] text-white">
          Six capabilities.<br /><span class="text-white/45">One system.</span>
        </h2>
        <p data-reveal class="mt-5 max-w-xl text-white/50">
          Most people buy these one at a time. I run them as a single stack — where each part feeds the next.
        </p>
        <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/8 bg-white/[0.02] sm:grid-cols-2 lg:grid-cols-3">
          {
            capabilities.map((c, i) => (
              <div data-reveal class="cap group relative bg-bg/40 p-6 transition-colors duration-300 hover:bg-accent/[0.05]">
                <div class="flex items-center justify-between">
                  <c.icon class="text-accent size-5 transition-transform duration-300 group-hover:-translate-y-0.5" stroke-width={1.6} />
                  <span class="font-mono text-[11px] tracking-[0.2em] text-white/25">0{i + 1}</span>
                </div>
                <h3 class="font-display mt-5 text-lg font-semibold tracking-tight text-white">{c.label}</h3>
                <p class="mt-2 text-[13.5px] leading-relaxed text-white/50">{c.desc}</p>
                <span class="cap-line absolute bottom-0 left-0 h-px w-0 bg-gradient-to-r from-accent to-transparent transition-[width] duration-500 group-hover:w-full"></span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 03 · HOW IT COMPOUNDS -->
      <section class="story-section">
        <p data-reveal class="eyebrow"><span class="tick"></span> <b>03</b> · The Compounding Effect</p>
        <h2 data-reveal class="display mt-6 max-w-3xl text-[clamp(1.9rem,5.5vw,3.4rem)] text-white">
          I don't sell projects.<br /><span class="from-accent-bright via-accent to-accent-bright bg-gradient-to-br bg-clip-text text-transparent">I build assets.</span>
        </h2>
        <div class="mt-14 flex flex-col gap-px overflow-hidden rounded-2xl border border-white/8">
          {
            principles.map((p) => (
              <div data-reveal class="grid items-baseline gap-4 bg-white/[0.02] p-7 md:grid-cols-[auto_1fr] md:p-9">
                <span class="font-mono text-sm text-accent/70">{p.n}</span>
                <div>
                  <h3 class="font-display text-[clamp(1.3rem,3.5vw,2rem)] font-semibold tracking-tight text-white">{p.t}</h3>
                  <p class="mt-2 max-w-2xl text-[15px] leading-relaxed text-white/50">{p.d}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 04 · PROOF -->
      <section class="story-section">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p data-reveal class="eyebrow"><span class="tick"></span> <b>04</b> · Selected Work</p>
            <h2 data-reveal class="display mt-6 text-[clamp(1.9rem,5.5vw,3.4rem)] text-white">Systems in production.</h2>
          </div>
          <p data-reveal class="font-mono text-[11px] tracking-[0.2em] text-white/35 uppercase">{work.length} of many · 2025–2026</p>
        </div>
        <div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-white/8 sm:grid-cols-2 lg:grid-cols-3">
          {
            work.map((w) => (
              <div data-reveal class="group relative flex flex-col bg-white/[0.02] p-6 transition-colors duration-300 hover:bg-white/[0.04]">
                <div class="flex items-center justify-between font-mono text-[10.5px] tracking-[0.18em] uppercase">
                  <span class="text-accent/80">{w.cat}</span>
                  {w.url && <span class="text-white/25 transition-colors group-hover:text-white/50">{w.url}</span>}
                </div>
                <h3 class="font-display mt-6 text-2xl font-semibold tracking-tight text-white">{w.name}</h3>
                <p class="mt-2 text-[13.5px] leading-relaxed text-white/50">{w.desc}</p>
                <span class="mt-5 font-mono text-[11px] tracking-wide text-white/35">{w.stack}</span>
                <span class="absolute bottom-0 left-0 h-px w-0 bg-gradient-to-r from-accent to-transparent transition-[width] duration-500 group-hover:w-full"></span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 05 · CONTACT -->
      <section class="story-section pb-28">
        <p data-reveal class="eyebrow"><span class="tick"></span> <b>05</b> · Open a Channel</p>
        <h2 data-reveal class="display mt-6 max-w-3xl text-[clamp(2rem,7vw,4rem)] text-white">
          Let's build<br />your <span class="from-accent-bright via-accent to-accent-bright bg-gradient-to-br bg-clip-text text-transparent">system.</span>
        </h2>
        <p data-reveal class="mt-6 max-w-lg text-white/50">
          Selective on projects — a few, done as real infrastructure. If that's the kind of work you need, reach out.
        </p>
        <div data-reveal class="mt-10 max-w-xl"><ContactReveal /></div>

        <div class="mt-24 flex flex-wrap items-center justify-between gap-4 border-t border-white/8 pt-8 font-mono text-[11px] tracking-[0.14em] text-white/30 uppercase">
          <span>© 2026 ongki.pro</span>
          <span>Building Digital Growth Systems</span>
        </div>
      </section>
    </main>

    <style>
      .scroll-cue { width: 1px; height: 34px; background: linear-gradient(to bottom, var(--color-accent), transparent); position: relative; overflow: hidden; }
      .scroll-cue::after { content: ''; position: absolute; inset: 0; background: var(--color-accent-bright); animation: cue 1.8s ease-in-out infinite; }
      @keyframes cue { 0% { transform: translateY(-100%); } 60%, 100% { transform: translateY(100%); } }
      .bp-hub-ring { animation: spin 18s linear infinite; transform-origin: center; }
      @keyframes spin { to { transform: rotate(360deg); } }
      .progress-rail { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 60; background: transparent; }
      .progress-rail span { display: block; height: 100%; width: 0; background: linear-gradient(to right, var(--color-accent), var(--color-accent-bright)); box-shadow: 0 0 8px var(--color-accent); }
    </style>

    <script>
      import gsap from 'gsap';
      import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(DrawSVGPlugin, ScrollTrigger);

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* --- scroll progress rail --- */
      gsap.to('#progress-fill', {
        width: '100%',
        ease: 'none',
        scrollTrigger: { trigger: document.body, start: 'top top', end: 'bottom bottom', scrub: 0.3 },
      });

      /* --- time-of-day phase + celestial position (WIB) --- */
      const forcedPhase = new URLSearchParams(location.search).get('phase');
      const REP: Record<string, number> = { dawn: 6.3, day: 12, dusk: 17.6, night: 22 };
      const wib = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Jakarta' }));
      const phase = document.documentElement.getAttribute('data-phase') || 'night';
      const hWib = forcedPhase && REP[forcedPhase] != null ? REP[forcedPhase] : wib.getHours() + wib.getMinutes() / 60;
      const LABELS: Record<string, string> = { dawn: 'SUBUH', day: 'SIANG', dusk: 'SENJA', night: 'MALAM' };
      const isMoon = phase === 'night';
      let pTarget: number;
      if (isMoon) { const hh = hWib < 5 ? hWib + 24 : hWib; pTarget = (hh - 19) / (29 - 19); }
      else { pTarget = (hWib - 5) / (19 - 5); }
      pTarget = Math.max(0.05, Math.min(0.95, pTarget));
      const arc = (t: number) => { const a = Math.PI - t * Math.PI; return { x: 200 + 160 * Math.cos(a), y: 190 - 160 * Math.sin(a) }; };

      const bodyG = document.getElementById('cel-body-g');
      const rays = document.getElementById('cel-rays');
      const moonMask = document.getElementById('cel-moon-mask');
      const percentEl = document.getElementById('loader-percent');
      const barSpan = document.getElementById('loader-bar');
      const statusEl = document.getElementById('loader-status');
      const phaseEl = document.getElementById('loader-phase');
      if (phaseEl) phaseEl.textContent = 'Phase · ' + LABELS[phase];

      // Sun gets rays; moon gets a crescent (offset bg-coloured mask).
      if (isMoon) { moonMask?.setAttribute('transform', 'translate(7 -4)'); }
      else if (rays) {
        moonMask?.remove();
        for (let i = 0; i < 8; i++) {
          const a = (i / 8) * Math.PI * 2;
          const l = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          l.setAttribute('class', 'cel-ray');
          l.setAttribute('x1', String((Math.cos(a) * 17).toFixed(1)));
          l.setAttribute('y1', String((Math.sin(a) * 17).toFixed(1)));
          l.setAttribute('x2', String((Math.cos(a) * 23).toFixed(1)));
          l.setAttribute('y2', String((Math.sin(a) * 23).toFixed(1)));
          rays.appendChild(l);
        }
      }
      const placeBody = (t: number) => { const pt = arc(t); bodyG?.setAttribute('transform', `translate(${pt.x.toFixed(1)} ${pt.y.toFixed(1)})`); };
      placeBody(0.06);

      /* hero pre-hide + reveal pre-hide (loader covers, so no flash) */
      gsap.set('header [data-head]', { opacity: 0, y: -12 });
      gsap.set('#hero [data-hero]', { opacity: 0, y: 18 });
      gsap.set('.word-inner', { yPercent: reduce ? 0 : 115 });
      gsap.set('[data-link]', { drawSVG: reduce ? '100%' : '0%' });
      gsap.set('[data-node]', { opacity: reduce ? 1 : 0, scale: reduce ? 1 : 0.6, transformOrigin: 'center' });
      gsap.set('[data-reveal]', { opacity: 0, y: 26 });

      function heroEntrance() {
        if (!reduce) gsap.to('#bg-glow', { xPercent: -7, yPercent: 5, duration: 16, repeat: -1, yoyo: true, ease: 'sine.inOut' });
        const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
        if (reduce) {
          gsap.set(['header [data-head]', '#hero [data-hero]'], { opacity: 1, y: 0 });
        } else {
          tl.to('header [data-head]', { opacity: 1, y: 0, duration: 0.7, stagger: 0.08 })
            .to('#hero [data-hero="eyebrow"]', { opacity: 1, y: 0, duration: 0.6 }, '-=0.4')
            .to('.word-inner', { yPercent: 0, duration: 1, stagger: 0.09 }, '-=0.3')
            .to('#hero [data-hero="sub"]', { opacity: 1, y: 0, duration: 0.7, stagger: 0.12 }, '-=0.7')
            .to('[data-hero="blueprint"]', { opacity: 1, y: 0, duration: 0.8 }, '-=1.1')
            .to('[data-link]', { drawSVG: '100%', duration: 0.9, stagger: 0.12, ease: 'power2.inOut' }, '-=0.6')
            .to('[data-node]', { opacity: 1, scale: 1, duration: 0.5, stagger: 0.06, ease: 'back.out(1.7)' }, '-=1')
            .add(() => document.querySelectorAll('[data-link]').forEach((el) => el.classList.add('flow', 'live')), '-=0.2')
            .add(() => document.querySelectorAll('[data-node]').forEach((n) => n.classList.add('live')));
        }
        ScrollTrigger.batch('[data-reveal]', {
          start: 'top 86%',
          onEnter: (els) => gsap.to(els, { opacity: 1, y: 0, duration: 0.85, stagger: 0.08, ease: 'expo.out', overwrite: true }),
        });
      }

      function finishLoader() {
        const loader = document.getElementById('loader');
        const tl = gsap.timeline({ onComplete: () => { if (loader) loader.style.display = 'none'; ScrollTrigger.refresh(); } });
        if (loader) tl.to(loader, { opacity: 0, duration: reduce ? 0.2 : 0.7, ease: 'power2.inOut' });
        tl.add(heroEntrance, reduce ? '>' : '-=0.25');
      }

      if (reduce) {
        if (statusEl) statusEl.textContent = 'System ready';
        if (percentEl) percentEl.textContent = '100';
        if (barSpan) gsap.set(barSpan, { scaleX: 1 });
        placeBody(pTarget);
        gsap.delayedCall(0.3, finishLoader);
      } else {
        const STEPS = [
          { s: 'Reading almanac', to: 18 },
          { s: 'Locating ' + (isMoon ? 'moon' : 'sun'), to: 44 },
          { s: 'Phase · ' + LABELS[phase], to: 68 },
          { s: 'Calibrating interface', to: 90 },
          { s: 'System ready', to: 100 },
        ];
        const counter = { v: 0 };
        const render = () => {
          if (percentEl) percentEl.textContent = String(Math.round(counter.v)).padStart(3, '0');
          if (barSpan) barSpan.style.transform = `scaleX(${counter.v / 100})`;
          placeBody(0.06 + (counter.v / 100) * (pTarget - 0.06));
        };
        const boot = gsap.timeline({ onComplete: finishLoader, delay: 0.25 });
        STEPS.forEach((step) => {
          boot.call(() => { if (statusEl) statusEl.textContent = step.s; });
          boot.to(counter, { v: step.to, duration: 0.5, ease: 'power2.out', onUpdate: render }, '+=0.06');
        });
      }

      /* --- magnetic hover (desktop pointer only) --- */
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (fine && !reduce) {
        document.querySelectorAll<HTMLElement>('.magnetic').forEach((el) => {
          const xTo = gsap.quickTo(el, 'x', { duration: 0.5, ease: 'power3' });
          const yTo = gsap.quickTo(el, 'y', { duration: 0.5, ease: 'power3' });
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            xTo((e.clientX - (r.left + r.width / 2)) * 0.3);
            yTo((e.clientY - (r.top + r.height / 2)) * 0.3);
          });
          el.addEventListener('pointerleave', () => { xTo(0); yTo(0); });
        });
      }

      /* --- custom cursor (desktop fine-pointer only) --- */
      if (fine && !reduce) {
        const dot = document.createElement('div');
        dot.className = 'cursor-el cursor-dot';
        const ring = document.createElement('div');
        ring.className = 'cursor-el cursor-ring';
        document.body.append(dot, ring);
        document.documentElement.classList.add('has-cursor');

        const dx = gsap.quickTo(dot, 'x', { duration: 0.11, ease: 'power3' });
        const dy = gsap.quickTo(dot, 'y', { duration: 0.11, ease: 'power3' });
        const rx = gsap.quickTo(ring, 'x', { duration: 0.42, ease: 'power3' });
        const ry = gsap.quickTo(ring, 'y', { duration: 0.42, ease: 'power3' });

        window.addEventListener('pointermove', (e) => {
          dx(e.clientX); dy(e.clientY); rx(e.clientX); ry(e.clientY);
          gsap.to([dot, ring], { opacity: 1, duration: 0.3, overwrite: 'auto' });
        }, { passive: true });
        document.addEventListener('pointerleave', () => gsap.to([dot, ring], { opacity: 0, duration: 0.3 }));

        const hot = 'a, button, .cap, .group, [data-node], input, textarea, [role="button"]';
        const enter = () => { ring.classList.add('is-hot'); dot.classList.add('is-hot'); };
        const leave = () => { ring.classList.remove('is-hot'); dot.classList.remove('is-hot'); };
        document.querySelectorAll(hot).forEach((el) => {
          el.addEventListener('pointerenter', enter);
          el.addEventListener('pointerleave', leave);
        });
        document.addEventListener('pointerdown', () => gsap.to(ring, { scale: 0.8, duration: 0.14 }));
        document.addEventListener('pointerup', () => gsap.to(ring, { scale: 1, duration: 0.22 }));
      }

      /* --- channel-open state after contact reveal --- */
      window.addEventListener('ongki:channel-open', () => {
        const status = document.getElementById('sys-status');
        status?.replaceChildren('Channel Open');
        status?.classList.add('text-accent-bright');
        document.getElementById('sys-dot')?.classList.add('channel-open');
      }, { once: true });
    </script>

    <script>
      if (import.meta.env.PROD) {
        document.documentElement.classList.add('locked');
        const stop = (e: Event) => e.preventDefault();
        document.addEventListener('contextmenu', stop);
        document.addEventListener('dragstart', stop);
      }
    </script>
  </body>
</html>
